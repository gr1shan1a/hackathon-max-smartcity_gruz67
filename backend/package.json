{
  "name": "max-smartcity-backend",
  "version": "1.0.0",
  "description": "Backend API & MAX Bot service for Smart City hackathon",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/setup.ts",
    "db:seed": "tsx src/db/setup.ts --seed",
    "test": "node --test scripts/integration.test.mjs",
    "bot:setup": "tsx src/bot/setup.ts",
    "test:bot": "node --test scripts/bot.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
