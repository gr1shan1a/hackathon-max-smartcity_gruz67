# MAX Platform & Smart City Environment Configuration
# Скопируйте этот файл в .env и укажите свои параметры при необходимости

# Токен чат-бота в мессенджере MAX (выдается оргкомитетом хакатона)
MAX_BOT_TOKEN=your_max_bot_token_here

# Порт бэкенд API
BACKEND_PORT=3001

# Порт веб-приложения
FRONTEND_PORT=5173

# Внешний базовый адрес для вебхуков MAX
BASE_WEBHOOK_URL=https://your-domain.example.com

# Local PostgreSQL (Docker Compose sets its own internal connection URL)
DATABASE_URL=postgresql://smartcity@127.0.0.1:55432/smartcity
POSTGRES_PASSWORD=smartcity-local-demo
DB_POOL_MAX=10
# Explicit demo mode; switching profiles is NOT real authentication
DEMO_MODE=true
# Public HTTPS URL to paste into MAX settings
MINI_APP_URL=

# MAX webhook bot (enable after setting HTTPS URL and registering webhook)
MAX_BOT_ENABLED=false
MAX_BOT_USERNAME=se14409794_bot
MAX_WEBHOOK_SECRET=
MAX_API_BASE=https://platform-api2.max.ru
# For api2 use the official CA via NODE_EXTRA_CA_CERTS if required by your runtime.
